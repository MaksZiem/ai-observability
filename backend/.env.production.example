# Production config. On the server copy this file to backend/.env and fill in the values.
# Never commit the real file.

NODE_ENV=production
# Port the backend listens on (localhost only, the reverse proxy forwards to it).
PORT=3001
# Public URL of the frontend. Used for CORS.
FRONTEND_URL=https://observability.example.com

# Database and user are created on the server (see DEPLOY.md).
DATABASE_URL=postgresql://observability:CHANGE_ME@localhost:5432/ai_observability
# Required in production: ingest queue and alert scheduler run on BullMQ.
REDIS_URL=redis://localhost:6379
# Key prefix in Redis, keeps queues apart when Redis is shared with other apps.
QUEUE_PREFIX=observability

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Keep false in production: blocks alert webhooks to private/internal addresses (SSRF).
ALLOW_PRIVATE_WEBHOOKS=false
