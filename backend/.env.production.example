# Production config. On the server copy this file to .env next to docker-compose.yml and fill in the values.
# Never commit the real file.

NODE_ENV=production
# Port the backend listens on (localhost only, the reverse proxy forwards to it).
PORT=3001
# Public URL of the frontend. Used for CORS.
FRONTEND_URL=https://ai-observability.zmax-dev.pl

# Postgres in Docker creates the database and user from these values.
# docker-compose.yml builds DATABASE_URL and REDIS_URL from them.
DB_USER=observability
DB_PASS=
DB_NAME=ai_observability
# Key prefix in Redis, keeps queues apart when Redis is shared with other apps.
QUEUE_PREFIX=observability

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Keep false in production: blocks alert webhooks to private/internal addresses (SSRF).
ALLOW_PRIVATE_WEBHOOKS=false
# Daily AI calls per user (protects the Gemini quota, also on the demo account).
AI_DAILY_LIMIT_PER_USER=30

# Docker Compose on the server
# Image versions from GHCR: latest or a commit sha
BACKEND_TAG=latest
FRONTEND_TAG=latest
# Ports on 127.0.0.1 that Caddy forwards to (different for every app and environment)
FRONTEND_PORT=3030
BACKEND_PORT=3031
