# Not used with Docker: CI passes NEXT_PUBLIC_* as build args (.github/workflows/ci.yml) and docker-compose.yml sets API_URL. Only needed without Docker.
# Test (staging) config. In the test copy on the server, copy this file to frontend/.env.production
# (next build always reads .env.production). NEXT_PUBLIC_* values are baked in at `npm run build`.

# Backend REST API of the test environment, called only from the Next.js server.
API_URL=http://localhost:3001/api
# Public test backend API used by the browser for live updates (through the reverse proxy, https).
NEXT_PUBLIC_API_URL=https://api.ai-observability-test.zmax-dev.pl/api
